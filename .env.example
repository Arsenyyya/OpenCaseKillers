# Generate actual LOCAL secrets with python scripts/bootstrap.py
APP_ENV=local
MODE=demo
DELIVERY_MODE=shadow
POSTGRES_PASSWORD=replace-with-bootstrap
WORKER_PASSWORD=replace-with-bootstrap
API_PASSWORD=replace-with-bootstrap
DATABASE_ADMIN_URL=postgresql+psycopg://agent_owner:replace@127.0.0.1:55432/agent
DATABASE_URL=postgresql+psycopg://agent_worker:replace@127.0.0.1:55432/agent
# internal requires HTTPS gateway, allowlisted hosts, token, CA, and verified corporate JWT.
# GATEWAY_URL=https://gateway.corp.example
# ALLOWED_HOSTS=["gateway.corp.example"]
# GATEWAY_TOKEN=external-secret
# INTERNAL_CA=/run/secrets/corporate-ca.pem
# JWT_ISSUER=https://issuer.corp.example
# JWT_AUDIENCE=support-insight
# JWT_PUBLIC_KEY=/run/secrets/issuer-public.pem
# BACKLOG_IDEMPOTENT=true
# BACKLOG_LOOKUP=true
