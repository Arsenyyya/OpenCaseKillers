{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "quote": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "segment_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Segment Id",
          "type": "string"
        }
      },
      "required": [
        "segment_id",
        "quote"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Item": {
      "additionalProperties": false,
      "properties": {
        "context": {
          "maxLength": 500,
          "title": "Context",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "kind": {
          "enum": [
            "feature_request",
            "defect",
            "service_request",
            "incident",
            "unclear"
          ],
          "title": "Kind",
          "type": "string"
        },
        "need": {
          "maxLength": 500,
          "minLength": 3,
          "title": "Need",
          "type": "string"
        },
        "needs_review": {
          "title": "Needs Review",
          "type": "boolean"
        },
        "review_reason": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Review Reason"
        },
        "urgency": {
          "enum": [
            "critical",
            "high",
            "normal",
            "unknown"
          ],
          "title": "Urgency",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "urgency",
        "need",
        "context",
        "evidence",
        "needs_review",
        "review_reason"
      ],
      "title": "Item",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/Item"
      },
      "maxItems": 20,
      "title": "Items",
      "type": "array"
    }
  },
  "required": [
    "items"
  ],
  "title": "Extraction",
  "type": "object"
}
