{
  "additionalProperties": false,
  "properties": {
    "content_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "decision": {
      "enum": [
        "accepted",
        "rejected",
        "needs_clarification"
      ],
      "title": "Decision",
      "type": "string"
    },
    "reason": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    }
  },
  "required": [
    "revision",
    "content_hash",
    "decision",
    "reason"
  ],
  "title": "DecisionRequest",
  "type": "object"
}
