{
  "$defs": {
    "Change": {
      "additionalProperties": false,
      "properties": {
        "backfill": {
          "default": false,
          "title": "Backfill",
          "type": "boolean"
        },
        "changed_at": {
          "format": "date-time",
          "title": "Changed At",
          "type": "string"
        },
        "external_id": {
          "pattern": "^[\\w-]{1,100}$",
          "title": "External Id",
          "type": "string"
        },
        "operation": {
          "enum": [
            "upsert",
            "delete",
            "access_revoked"
          ],
          "title": "Operation",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "version": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "sequence",
        "external_id",
        "version",
        "operation",
        "changed_at"
      ],
      "title": "Change",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "changes": {
      "items": {
        "$ref": "#/$defs/Change"
      },
      "maxItems": 200,
      "title": "Changes",
      "type": "array"
    },
    "has_more": {
      "title": "Has More",
      "type": "boolean"
    },
    "next_cursor": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Next Cursor",
      "type": "string"
    }
  },
  "required": [
    "changes",
    "next_cursor",
    "has_more"
  ],
  "title": "ChangeBatch",
  "type": "object"
}
