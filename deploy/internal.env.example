# EXAMPLE ONLY. Store actual values outside Git and mount keys/CA read-only.
APP_ENV=internal
MODE=internal
DELIVERY_MODE=shadow
SERVICE_PRODUCTS=["pilot-product"]
DATABASE_URL=postgresql+psycopg://agent_worker:external-secret@db.corp.example/agent
GATEWAY_URL=https://gateway.corp.example
GATEWAY_TOKEN=external-secret
ALLOWED_HOSTS=["gateway.corp.example"]
INTERNAL_CA=/run/secrets/internal-ca.pem
JWT_ISSUER=https://issuer.corp.example
JWT_AUDIENCE=support-insight
JWT_PUBLIC_KEY=/run/secrets/issuer-public.pem
EXTRACTION_MODEL=Qwen 3.8
ASR_MODEL=Qwen-ASR
VL_MODEL=Qwen-VL
BACKLOG_IDEMPOTENT=false
BACKLOG_LOOKUP=false
# Administrative credentials belong only to separate migrate/provision jobs:
# DATABASE_ADMIN_URL=postgresql+psycopg://migration-owner:external-secret@db.corp.example/agent
